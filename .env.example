# ISPCENTRIC — plain KEY=value lines only (UTF-8, no BOM).
# Do not paste markdown, export, or shell commands into this file.

# VPS / production: copy .env.production.example instead of this file.
# On Ubuntu at /opt/ispcentric, DJANGO_HOSTED=true is auto-detected even when
# DJANGO_HOSTED=auto — still set it explicitly in .env to avoid surprises.

DJANGO_HOSTED=auto

MYSQL_USER=cpaneluser_dbuser
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=cpaneluser_dbname

# Optional:
# DJANGO_SECRET_KEY=long-random-secret
# Dedicated Fernet key/passphrase for DB field encryption (recommended on hosted).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=
# DJANGO_DEBUG=False
# Disable auto schema repair only if needed:
# DJANGO_AUTO_MIGRATE=false
# Seconds to skip DB schema probes after a successful check (local dev reloads):
# DJANGO_SCHEMA_CHECK_COOLDOWN=120
# Local dev: python manage.py devserver  (faster reloads than runserver)
# On startup (local runserver and hosted WSGI) the app syncs WireGuard peers
# and runs the subscription sweep. Disable with:
# SUBSCRIPTION_SWEEP_ENABLED=false
# WIREGUARD_AUTO_SYNC=false
# Background PPPoE/Hotspot usage snapshots for trend charts (no page visit needed):
# USAGE_SAMPLE_ENABLED=true
# USAGE_SAMPLE_INTERVAL_SEC=90
# USAGE_SAMPLE_STARTUP_DELAY_SEC=35
# Subscription access sweep (default 180s) and near-deadline watch (default 60s):
# SUBSCRIPTION_SWEEP_INTERVAL_SEC=180
# SUBSCRIPTION_EXPIRY_WATCH_INTERVAL_SEC=60
# On VPS with systemd sweep timer: SUBSCRIPTION_SWEEP_ENABLED=false and
# SUBSCRIPTION_EXPIRY_WATCH_ENABLED=true keeps 60s deadline enforcement.
# SUBSCRIPTION_EXPIRY_WATCH_ENABLED=true
# Smart balance background monitor (default 90s, 2 parallel routers):
# SMART_BALANCE_MONITOR_INTERVAL_SEC=90
# Reduce RouterOS CPU — byte-delta polling instead of monitor-traffic (default off):
# MIKROTIK_USE_MONITOR_TRAFFIC=false
# Live admin page poll intervals in milliseconds (longer = lighter on MikroTik):
# MIKROTIK_PORTS_POLL_MS=12000
# MIKROTIK_ASSIGNED_PORTS_POLL_MS=15000
# MIKROTIK_DETAIL_POLL_MS=20000
# VPS watchdog: repair MikroTik management + WAN when probes fail (sample_mikrotik_status):
# MIKROTIK_AUTO_RESTORE=true
# MIKROTIK_AUTO_RESTORE_COOLDOWN_SEC=300
# MIKROTIK_INTERNET_PROBE_COOLDOWN_SEC=300
# MIKROTIK_AUTO_RESTORE_ALERTS=true
# MIKROTIK_AUTO_RESTORE_ALERT_COOLDOWN_SEC=3600
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# GOOGLE_MAPS_API_KEY=
# Public site URL (no trailing slash). On hosted installs this also sets the
# Daraja STK callback to {PUBLIC_BASE_URL}/api/mpesa/stk-callback/ — keep it in
# sync with Settings → Payments and IT Support → Payment Gateway.
# PUBLIC_BASE_URL=https://billing.example.com
