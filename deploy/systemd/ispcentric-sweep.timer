[Unit]
Description=Run the ISPCENTRIC expiry sweep every 5 minutes

[Timer]
OnBootSec=3min
# 5 min from end of last run — reduces paid CPE bounce from overlapping
# secret rewrites while expiry-watch still cuts unpaid within ~90s.
OnUnitInactiveSec=5min
# Measured from the end of the last run, so slow runs cannot overlap.
AccuracySec=15s
Unit=ispcentric-sweep.service

[Install]
WantedBy=timers.target
