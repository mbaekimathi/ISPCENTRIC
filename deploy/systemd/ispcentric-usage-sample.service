[Unit]
Description=ISPCENTRIC customer usage sample (General usage charts)
After=network-online.target ispcentric.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/ispcentric
EnvironmentFile=/opt/ispcentric/.env
ExecStart=/opt/ispcentric/scripts/sample_customer_usage.sh
# A slow MikroTik fleet must not wedge the timer forever.
TimeoutStartSec=300
