# ISPCENTRIC production — isp.richcom.co.ke (template)
# Copy to /opt/ispcentric/.env and fill secrets. See deploy/DEPLOY_NOW.md

DJANGO_HOSTED=true
DJANGO_DEBUG=False

DJANGO_SECRET_KEY=replace-with-manage-py-secret-key
# If DB already has enc1: secrets, set this to a copy of DJANGO_SECRET_KEY first.
# Fresh installs: Fernet key from cryptography.fernet.Fernet.generate_key().
FIELD_ENCRYPTION_KEY=replace-with-fernet-key-or-copy-of-current-secret-key

DJANGO_ALLOWED_HOSTS=isp.richcom.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=http://isp.richcom.co.ke

# Safaricom Daraja STK callback source IPs (exact match after nginx X-Real-IP).
MPESA_CALLBACK_ALLOWED_IPS=196.201.214.200,196.201.214.206,196.201.214.207,196.201.214.208,196.201.213.114,196.201.213.44,196.201.212.127,196.201.212.138,196.201.212.129,196.201.212.136,196.201.212.74,196.201.212.69

DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

PUBLIC_BASE_URL=http://isp.richcom.co.ke

DJANGO_TRUSTED_PROXY_IPS=127.0.0.1,::1
DJANGO_SERVE_MEDIA=false

WIREGUARD_ENDPOINT=isp.richcom.co.ke:51820
WIREGUARD_SERVER_PUBLIC_KEY=UkOOxC6oM/Qyg53HUL/u3XKwK6ITa1VzBg9xlYqcyns=
WIREGUARD_SUBNET=10.9.0.0/24
WIREGUARD_SYNC_COMMAND="sudo /opt/ispcentric/scripts/wireguard_apply_peer.sh"
WIREGUARD_AUTO_SYNC=true

SUBSCRIPTION_SWEEP_ENABLED=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ispcentric
MYSQL_USER=ispcentric
MYSQL_PASSWORD=replace-with-strong-db-password

GOOGLE_MAPS_API_KEY=
