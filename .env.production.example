# ISPCENTRIC — VPS production environment.
# Copy to .env on the server and fill in. Plain KEY=value, UTF-8, no BOM.
# systemd reads this file directly, so do not quote values or use `export`.

# Forces DEBUG off and ALLOWED_HOSTS open. Without this, a VPS outside /home
# is treated as a local dev box and DEBUG silently turns back on.
DJANGO_HOSTED=true
DJANGO_DEBUG=False

# Generate once with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

DJANGO_ALLOWED_HOSTS=isp.richcom.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=http://isp.richcom.co.ke
# Do not use DJANGO_ALLOWED_HOSTS=* on production. If you must, also set
# DJANGO_ALLOW_WILDCARD_HOSTS=true and pin DJANGO_CSRF_TRUSTED_ORIGINS — auto
# CSRF origin injection is disabled while "*" is active.
# Optional: only accept Daraja callbacks from these IPs (comma-separated).
# MPESA_CALLBACK_ALLOWED_IPS=
# STK success callbacks confirm with Daraja STK Query before fulfillment (default true).
# STK_CALLBACK_REQUIRE_DARAJA_QUERY=true

# Captive portals must stay on plain HTTP, and secure cookies are never sent
# over HTTP — leaving these on would make login silently fail. Flip both to
# true (and add the https:// origin above) as soon as TLS is issued.
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

# Pushed to MikroTik as the portal target and used as the dst-nat destination
# for expired PPPoE clients. No trailing slash. On local/dev use "auto" (or leave
# empty) so the current LAN IP is picked; on hosted always set the public host.
PUBLIC_BASE_URL=http://isp.richcom.co.ke

# nginx runs on the same host and terminates the client connection.
DJANGO_TRUSTED_PROXY_IPS=127.0.0.1,::1

# nginx serves /static/ and /media/ directly.
DJANGO_SERVE_MEDIA=false

# WireGuard tunnel the routers dial so this server can reach their API. Without
# it every push times out, because a router's LAN address is unroutable here.
# Get the public key from `manage.py wireguard_peer --server-keys`; the matching
# private key belongs in /etc/wireguard/wg0.conf only, never in this file.
WIREGUARD_ENDPOINT=isp.richcom.co.ke:51820
WIREGUARD_SERVER_PUBLIC_KEY=
WIREGUARD_SUBNET=10.9.0.0/24
# Lets the app register MikroTik peers when scripts are generated (requires sudoers below).
# Without this, Winbox paste succeeds but ping/handshake to 10.9.0.1 fails forever.
WIREGUARD_SYNC_COMMAND=sudo /opt/ispcentric/scripts/wireguard_apply_peer.sh
# App start (gunicorn/Passenger) brings wg0 peers up to date automatically.
WIREGUARD_AUTO_SYNC=true

# After deploy, vps_deploy.sh / cpanel_after_pull.sh already run sync_nas_config.
# Set true only if every app restart should re-push all MikroTiks (slow).
# NAS_CONFIG_SYNC_ON_BOOT=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ispcentric
MYSQL_USER=ispcentric
MYSQL_PASSWORD=replace-with-a-strong-db-password

GOOGLE_MAPS_API_KEY=
